<div class="eb-links">
  {% if section_title %}
    {% set tag = heading_level|default('h3') %}
    <{{ tag }} class="eb-links__section-title">{{ section_title }}</{{ tag }}>
  {% endif %}
  {% if before_text %}
    <p class="eb-links__before-text">{{ before_text }}</p>
  {% endif %}
  {% if links %}
    <ul class="eb-links__list">
      {% block links %}
        {{ links }}
      {% endblock %}
    </ul>
  {% endif %}
  {% if after_text %}
    <p class="eb-links__after-text">{{ after_text }}</p>
  {% endif %}
</div>
