<div class="eb-image-html">
  {% if title %}
    {% set tag = heading_level|default('h2') %}
    <{{ tag }} class="eb-image-html__title">{{ title }}</{{ tag }}>
  {% endif %}
  <div class="eb-image-html__row eb-image-html__row--{{ image_position|default('left') }}">
    {% if image %}
      <div class="eb-image-html__image-wrap">
        {% include 'canvas:image' with image|merge({
          class: 'eb-image-html__image',
        }|filter((value) => value is not null)) only %}
        {% if caption %}
          <p class="eb-image-html__caption eb-image-html__caption--{{ caption_alignment|default('left') }}">{{ caption }}</p>
        {% endif %}
      </div>
    {% endif %}
    {% if html %}
      <div class="eb-image-html__content">{{ html }}</div>
    {% endif %}
  </div>
</div>
