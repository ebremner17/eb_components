{% set images = images|default([]) %}
<div
  class="eb-slideshow{{ display_type == 'contained' ? ' eb-slideshow--contained' : '' }}"
  data-slide-speed="{{ slide_speed|default(5000) }}"
  data-transition-speed="{{ transition_speed|default(400) }}"
>
  {% for image in images %}
    <div class="eb-slideshow__slide{{ loop.first ? ' is-active' : '' }}">
      <picture>
        <source media="(min-width: 769px)" srcset="{{ eb_image_style(image.src, 'eb_is_slideshow_desktop') }}">
        <img
          class="eb-slideshow__image"
          src="{{ eb_image_style(image.src, 'eb_is_slideshow_mobile') }}"
          alt="{{ image.alt|default('') }}"
          loading="{{ loop.first ? 'eager' : 'lazy' }}"
        >
      </picture>
    </div>
  {% endfor %}

  {% if images|length > 1 %}
    <div class="eb-slideshow__controls">
      <button type="button" class="eb-slideshow__toggle" aria-label="{{ 'Pause slideshow'|t }}">
        <svg class="eb-slideshow__icon-play" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 1l12 7-12 7z"/></svg>
        <svg class="eb-slideshow__icon-pause" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 1h4v14H3zM9 1h4v14H9z"/></svg>
      </button>
      <div class="eb-slideshow__progress">
        {% for image in images %}
          <button
            type="button"
            class="eb-slideshow__segment{{ loop.first ? ' is-active' : '' }}"
            aria-label="{{ 'Go to slide @number'|t({'@number': loop.index}) }}"
          ></button>
        {% endfor %}
      </div>
    </div>
  {% endif %}
</div>
